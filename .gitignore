# Virtualenv
.venv/

# Python bytecode / build artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Local credentials and machine-local config — never commit these
.env
config.toml

# Backups of the live Sieve script, written before each upload
backups/
*.sieve.bak

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# The operator's GLOBAL gitignore ignores `Makefile` -- reasonable there,
# since generated autotools/cmake Makefiles are common noise. Ours is a
# hand-written, tracked source file, and four docs tell the reader to run
# `make test`. Un-ignore it explicitly: a repo .gitignore outranks the
# global one, and without this line the file is silently never committed.
!Makefile
